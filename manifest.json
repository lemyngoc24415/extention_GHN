{
  "manifest_version": 3,
  "name": "GHN Helper Pro",
  "version": "1.0",
  "description": "Quản lý và phân loại đơn hàng GHN",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ghn.vn/*",
        "*://nhanh.ghn.vn/*"
      ],
      "js": [
        "src/core/ConfigManager.js",
        "src/features/OrderInfo.js",
        "src/features/HideReceipt.js",
        "src/features/BulkDelete.js",
        "src/features/AutoPacking.js",
        "src/features/OrderChecker.js",
        "src/features/PackageAlert.js",
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "assets/sounds/*.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}